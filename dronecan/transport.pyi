from collections import OrderedDict
from collections.abc import Iterable, Iterator, MutableSequence
from typing import ClassVar, Literal, NoReturn, TypeAlias, TypeVar, overload
from . import UAVCANException
from .dsdl.parser import ArrayType, CompoundType, PrimitiveType, Type, VoidType

long = int

_T = TypeVar('_T')
_FieldInput: TypeAlias = int | float | str | BaseValue | Iterable['_FieldInput'] | None
_ArrayElement: TypeAlias = int | float | BaseValue | None

@overload
def get_dronecan_data_type(obj: CompoundValue) -> CompoundType: ...
@overload
def get_dronecan_data_type(obj: PrimitiveValue) -> PrimitiveType: ...
@overload
def get_dronecan_data_type(obj: ArrayValue) -> ArrayType: ...
@overload
def get_dronecan_data_type(obj: VoidValue) -> VoidType: ...
@overload
def get_dronecan_data_type(obj: BaseValue) -> Type: ...
def is_union(obj: CompoundValue) -> bool: ...
def get_active_union_field(obj: CompoundValue) -> str | None: ...
def switch_union_field(obj: CompoundValue, value: str | None) -> None: ...
def get_fields(obj: CompoundValue) -> OrderedDict[str, BaseValue]: ...
def get_constants(obj: CompoundValue) -> dict[str, int | float]: ...
def is_request(obj: CompoundValue) -> bool: ...
def is_response(obj: CompoundValue) -> bool: ...
def bits_from_bytes(s: Iterable[int]) -> str: ...
def bytes_from_bits(s: str) -> bytearray: ...
def be_from_le_bits(s: str, bitlen: int) -> str: ...
def le_from_be_bits(s: str, bitlen: int) -> str: ...
def format_bits(s: str) -> str: ...
def union_tag_bits_from_num_elements(num_elements: int) -> int: ...
def array_len_bits_from_max_size(max_size: int) -> int: ...
def enum_mark_last(iterable: Iterable[_T], start: int = 0) -> Iterator[tuple[int, bool, _T]]: ...

class Float32IntegerUnion:
    def __init__(self, integer: int | None = None, floating_point: float | None = None) -> None: ...
    @property
    def f(self) -> float: ...
    @f.setter
    def f(self, value: float) -> None: ...
    @property
    def u(self) -> int: ...
    @u.setter
    def u(self, value: int) -> None: ...

def bchr(x: int) -> bytes: ...
def f16_from_f32(float32: float) -> int: ...
def f32_from_f16(float16: int) -> float: ...
def cast(value: int | float, dtype: PrimitiveType) -> int | float: ...

class BaseValue:
    _type: Type
    _bits: str | None
    def __init__(self, _dronecan_type: Type, *_args: object, **_kwargs: object) -> None: ...
    def _unpack(self, stream: str, tao: bool) -> str: ...
    def _pack(self, tao: bool) -> str: ...

class VoidValue(BaseValue): ...

class PrimitiveValue(BaseValue):
    def __init__(self, _dronecan_type: PrimitiveType, *args: object, **kwargs: object) -> None: ...
    @property
    def value(self) -> int | float | None: ...
    @value.setter
    def value(self, new_value: int | float) -> None: ...
    def __repr__(self) -> str: ...

class ArrayValue(BaseValue, MutableSequence[_ArrayElement]):
    def __init__(self, _dronecan_type: ArrayType, *args: object, **kwargs: object) -> None: ...
    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...
    @overload
    def __getitem__(self, idx: int) -> _ArrayElement: ...
    @overload
    def __getitem__(self, idx: slice) -> list[_ArrayElement]: ...
    @overload
    def __setitem__(self, idx: int, value: _ArrayElement) -> None: ...
    @overload
    def __setitem__(self, idx: slice, value: Iterable[_ArrayElement]) -> NoReturn: ...
    def __delitem__(self, idx: int | slice) -> None: ...
    def __len__(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def clear(self) -> None: ...
    def new_item(self) -> PrimitiveValue | ArrayValue | CompoundValue: ...
    def insert(self, idx: int, value: _ArrayElement) -> None: ...
    def from_bytes(self, value: Iterable[int]) -> None: ...
    def to_bytes(self) -> bytes: ...
    def encode(self, value: str, errors: str = 'strict') -> None: ...
    def decode(self, encoding: str = 'utf-8') -> str: ...

class CompoundValue(BaseValue):
    _mode: Literal['request', 'response'] | None
    _fields: OrderedDict[str, BaseValue]
    _constants: dict[str, int | float]
    def __init__(self, _dronecan_type: CompoundType, _mode: Literal['request', 'response'] | None = None, *args: object, **kwargs: _FieldInput) -> None: ...
    def __repr__(self) -> str: ...
    def __copy__(self) -> CompoundValue: ...
    def __deepcopy__(self, memo: dict[int, object]) -> CompoundValue: ...
    def __getattr__(self, attr: str) -> int | float | BaseValue | None: ...
    def __setattr__(self, attr: str, value: _FieldInput) -> None: ...
    def _unpack(self, stream: str, tao: bool = True) -> str: ...
    def _pack(self, tao: bool = True) -> str: ...

class Frame:
    message_id: int
    bytes: bytearray
    ts_monotonic: float | None
    ts_real: float | None
    canfd: bool
    def __init__(self, message_id: int, data: Iterable[int], ts_monotonic: float | None = None, ts_real: float | None = None, canfd: bool = False) -> None: ...
    @property
    def transfer_key(self) -> tuple[int, int | None]: ...
    @property
    def toggle(self) -> bool: ...
    @property
    def end_of_transfer(self) -> bool: ...
    @property
    def start_of_transfer(self) -> bool: ...

class TransferError(UAVCANException): ...

def datalength_roundup(data_length: int) -> int: ...

class Transfer:
    DEFAULT_TRANSFER_PRIORITY: ClassVar[int]
    transfer_id: int
    source_node_id: int | None
    dest_node_id: int | None
    payload: bytearray | CompoundValue | None
    transfer_priority: int
    request_not_response: bool
    service_not_message: bool
    discriminator: int | None
    canfd: bool
    ts_monotonic: float | None
    ts_real: float | None
    data_type_id: int | None
    data_type_signature: int | None
    data_type_crc: int | None
    is_complete: bool
    def __init__(self, transfer_id: int = 0, source_node_id: int | None = 0, dest_node_id: int | None = None, payload: CompoundValue | None = None, transfer_priority: int | None = None, request_not_response: bool = False, service_not_message: bool = False, discriminator: int | None = None, canfd: bool = False) -> None: ...
    def __repr__(self) -> str: ...
    @property
    def message_id(self) -> int: ...
    @message_id.setter
    def message_id(self, value: int) -> None: ...
    def to_frames(self) -> list[Frame]: ...
    def from_frames(self, frames: list[Frame]) -> None: ...
    @property
    def key(self) -> tuple[int, int]: ...
    def is_response_to(self, transfer: Transfer) -> bool: ...

class TransferManager:
    active_transfers: dict[tuple[int, int | None], list[Frame]]
    active_transfer_timestamps: dict[tuple[int, int | None], float]
    def __init__(self) -> None: ...
    def receive_frame(self, frame: Frame) -> list[Frame] | None: ...
    def remove_inactive_transfers(self, timeout: float = 1.0) -> None: ...
