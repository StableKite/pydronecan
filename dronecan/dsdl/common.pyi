    def __str__(self) -> str: ...

def pretty_filename(filename: str) -> str: ...
def crc16_from_bytes(bytes: Iterable[int] | str, initial: int = 0xFFFF) -> int: ...
def bytes_from_crc64(crc64: int) -> bytes: ...
